# 由 clearme 生成，请勿编辑。
# 语言与键盘
d-i debian-installer/language string en
d-i debian-installer/country string US
d-i debian-installer/locale string en_US.UTF-8
d-i keyboard-configuration/xkb-keymap select us

# 网络
d-i netcfg/choose_interface select {{.Interface}}
{{- if .Static}}
d-i netcfg/disable_autoconfig boolean true
d-i netcfg/get_ipaddress string {{.IP}}
{{- if .Netmask}}
d-i netcfg/get_netmask string {{.Netmask}}
{{- end}}
{{- if .Gateway}}
d-i netcfg/get_gateway string {{.Gateway}}
{{- end}}
d-i netcfg/get_nameservers string {{.DNS}}
d-i netcfg/confirm_static boolean true
{{- else}}
d-i netcfg/get_nameservers string {{.DNS}}
{{- end}}
d-i netcfg/get_hostname string {{.Hostname}}
d-i netcfg/get_domain string
d-i hw-detect/load_firmware boolean true
# 早期入口：启用时启动安装器 sshd，并把安全仓库钩子交给 base-installer。
d-i preseed/early_command string sh /clearme-assets/early.sh

# 镜像
d-i mirror/country string manual
d-i mirror/protocol string {{.MirrorProtocol}}
d-i mirror/{{.MirrorProtocol}}/hostname string {{.MirrorHost}}
d-i mirror/{{.MirrorProtocol}}/directory string {{.MirrorDir}}
d-i mirror/http/proxy string {{.Proxy}}
d-i mirror/suite string {{.Suite}}

# 时间与时区
d-i clock-setup/utc boolean true
d-i time/zone string {{.Timezone}}
d-i clock-setup/ntp boolean true
d-i clock-setup/ntp-server string {{.NTP}}

# 分区
# 安装器启动后先按磁盘标识重新定位目标设备，再写入 partman-auto/disk
# 和 grub-installer/bootdev，避免重启后设备名变化导致装错磁盘。
d-i partman/early_command string sh /clearme-assets/partman-early.sh
{{- if .KeepParts}}
# keep-data 模式：不要设置 partman-auto/method。"regular" 方法会重建磁盘标签，
# 把需要保留的分区一起擦除。early_command 已删除除保留分区以外的所有分区，
# partman-auto 只在最大的空闲区域里创建新系统，已有分区保持原样。
d-i partman-auto/init_automatically_partition select biggest_free
{{- else}}
d-i partman-auto/method string regular
d-i partman-auto/disk string {{.Disk}}
{{- end}}
d-i partman-partitioning/choose_label string {{.DiskLabel}}
d-i partman-partitioning/default_label string {{.DiskLabel}}
d-i partman/default_filesystem string {{.Filesystem}}
d-i partman-auto/expert_recipe string \
    clearme :: \
{{- if .EFI}}
        {{.ESPSize}} {{.ESPSize}} {{.ESPSize}} free \
            $iflabel{ gpt } \
{{- if not .KeepParts}}
            $reusemethod{ } \
{{- end}}
            method{ efi } \
            format{ } \
        . \
{{- else if eq .DiskLabel "gpt"}}
        1 1 1 free \
            $iflabel{ gpt } \
            method{ biosgrub } \
        . \
{{- end}}
        1075 4096 -1 $default_filesystem \
            method{ format } \
            format{ } \
            use_filesystem{ } \
            $default_filesystem{ } \
            mountpoint{ / } \
        .
d-i partman-auto/choose_recipe select clearme
d-i partman-basicfilesystems/no_swap boolean false
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
{{- if .EFI}}
d-i partman-efi/non_efi_system boolean true
{{- end}}

# 基础系统
d-i base-installer/kernel/image string linux-image-{{.Arch}}

# APT 源
d-i apt-setup/contrib boolean false
d-i apt-setup/non-free boolean false
{{- if .NonFreeFirmware}}
d-i apt-setup/non-free-firmware boolean true
{{- end}}
d-i apt-setup/enable-source-repositories boolean false
d-i apt-setup/services-select multiselect updates
{{- if .SecurityRepo}}
d-i apt-setup/local0/repository string {{.SecurityRepo}} {{.SecuritySuite}} main
d-i apt-setup/local0/source boolean false
{{- end}}

# 软件包
tasksel tasksel/first multiselect ssh-server
{{- if .Install}}
d-i pkgsel/include string {{.Install}}
{{- end}}
{{- if .Upgrade}}
d-i pkgsel/upgrade select {{.Upgrade}}
{{- end}}
popularity-contest popularity-contest/participate boolean false

# 账户
{{- if eq .Username "root"}}
d-i passwd/root-login boolean true
d-i passwd/make-user boolean false
d-i passwd/root-password-crypted password {{.PasswordHash}}
{{- else}}
d-i passwd/root-login boolean false
d-i passwd/make-user boolean true
d-i passwd/user-fullname string {{.Username}}
d-i passwd/username string {{.Username}}
d-i passwd/user-password-crypted password {{.PasswordHash}}
{{- end}}

# 引导器
d-i grub-installer/bootdev string {{.Disk}}
d-i grub-installer/force-efi-extra-removable boolean true

# 收尾
d-i preseed/late_command string sh /clearme-assets/late.sh
d-i finish-install/reboot_in_progress note
